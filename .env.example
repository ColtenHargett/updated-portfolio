# Optional. Enables the AI-written briefing in the News Summary Agent demo.
# Without it, the demo still shows the live, most-covered stories.
GEMINI_API_KEY=
# Optional. Pin a model; by default the site uses gemini-flash-latest, then the newest available Flash model.
GEMINI_MODEL=
# Recommended. Any random string; protects the morning /api/cron/briefing route.
CRON_SECRET=
